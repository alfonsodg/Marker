<?xml version="1.0" encoding="UTF-8"?>
<interface domain="marker">
  <object class="GtkPopoverMenu" id="gear_menu_popover">
    <child>
      <object class="GtkBox" id="gear_menu_popover_vbox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="margin">8</property>

        <!-- Zoom Controls -->
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="homogeneous">True</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkButton" id="zoom_out_btn">
                <property name="visible">True</property>
                <property name="action_name">win.zoomout</property>
                <property name="tooltip-text" translatable="yes">Zoom Out</property>
                <child>
                  <object class="GtkImage">
                    <property name="visible">True</property>
                    <property name="icon-name">zoom-out-symbolic</property>
                    <property name="icon-size">1</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="zoom_original_btn">
                <property name="visible">True</property>
                <property name="action_name">win.zoomoriginal</property>
                <property name="tooltip-text" translatable="yes">Zoom Reset</property>
                <property name="label"></property>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="zoom_in_btn">
                <property name="visible">True</property>
                <property name="action_name">win.zoomin</property>
                <property name="tooltip-text" translatable="yes">Zoom In</property>
                <child>
                  <object class="GtkImage">
                    <property name="visible">True</property>
                    <property name="icon-name">zoom-in-symbolic</property>
                    <property name="icon-size">1</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
          </object>
        </child>

        <!-- File section. The id is used by marker-window.c to register the
             application actions, so it must stay. -->
        <child>
          <object class="GtkBox" id="appmenu_popover_items_start">
            <property name="visible">False</property>
            <property name="can_focus">False</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkSeparator">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="file_section_label">
                <property name="visible">True</property>
                <property name="label" translatable="yes">File</property>
                <property name="xalign">0</property>
                <property name="margin-top">2</property>
                <property name="margin-bottom">2</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="new_window_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">New Window</property>
                <property name="action-name">app.new</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="open_new_window_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Open in New Window…</property>
                <property name="action-name">win.opennew</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="save_as_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Save As…</property>
                <property name="action-name">win.saveas</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="export_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Export with Format Choice…</property>
                <property name="action-name">win.export</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="quick_pdf_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Quick PDF Beside the File</property>
                <property name="action-name">app.export-pdf</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="print_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Print…</property>
                <property name="action-name">win.print</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Edit section -->
        <child>
          <object class="GtkBox" id="edit_section_box">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkSeparator">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="edit_section_label">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Edit</property>
                <property name="xalign">0</property>
                <property name="margin-top">2</property>
                <property name="margin-bottom">2</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="find_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Find and Replace…</property>
                <property name="action-name">win.find</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="insert_table_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Insert Table</property>
                <property name="action-name">win.table</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="insert_mermaid_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Insert Mermaid Diagram</property>
                <property name="action-name">win.mermaid</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="insert_link_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Insert Link</property>
                <property name="action-name">win.link</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="sketcher_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Open Sketcher</property>
                <property name="action-name">win.sketcher</property>
              </object>
            </child>
          </object>
        </child>

        <!-- View section -->
        <child>
          <object class="GtkBox" id="view_section_box">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkSeparator">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="view_section_label">
                <property name="visible">True</property>
                <property name="label" translatable="yes">View</property>
                <property name="xalign">0</property>
                <property name="margin-top">2</property>
                <property name="margin-bottom">2</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="view_mode_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">View Mode</property>
                <property name="menu-name">view</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="sidebar_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Outline Sidebar</property>
                <property name="action-name">win.sidebar</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="refresh_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Refresh Preview</property>
                <property name="action-name">win.refresh</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton" id="fullscreen_btn">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Fullscreen</property>
                <property name="action-name">win.fullscreen</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Application section. The id is used by marker-window.c when the
             desktop has no app menu, so it must stay. -->
        <child>
          <object class="GtkBox" id="appmenu_popover_items_end">
            <property name="visible">False</property>
            <property name="can_focus">False</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkSeparator">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="app_section_label">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Application</property>
                <property name="xalign">0</property>
                <property name="margin-top">2</property>
                <property name="margin-bottom">2</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkModelButton">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Preferences</property>
                <property name="action-name">app.prefs</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Keyboard Shortcuts</property>
                <property name="action-name">app.shortcuts</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Help</property>
                <property name="action-name">app.help</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">About NeoMarker</property>
                <property name="action-name">app.about</property>
              </object>
            </child>
            <child>
              <object class="GtkModelButton">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="text" translatable="yes">Quit</property>
                <property name="action-name">app.quit</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- View Mode submenu -->
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="orientation">vertical</property>
        <property name="margin">8</property>
        <child>
          <object class="GtkModelButton">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="text" translatable="yes">View Mode</property>
            <property name="inverted">True</property>
            <property name="menu-name">main</property>
            <property name="centered">True</property>
          </object>
        </child>
        <child>
          <object class="GtkModelButton" id="editor_only_mode_btn">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="text" translatable="yes">Editor Only</property>
            <property name="action-name">win.editoronlymode</property>
          </object>
        </child>
        <child>
          <object class="GtkModelButton" id="preview_only_mode_btn">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="text" translatable="yes">Preview Only</property>
            <property name="action-name">win.previewonlymode</property>
          </object>
        </child>
        <child>
          <object class="GtkModelButton" id="dual_pane_mode_btn">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="text" translatable="yes">Dual Pane</property>
            <property name="action-name">win.dualpanemode</property>
          </object>
        </child>
        <child>
          <object class="GtkModelButton" id="dual_window_mode_btn">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="text" translatable="yes">Dual Window</property>
            <property name="action-name">win.dualwindowmode</property>
          </object>
        </child>
      </object>
      <packing>
        <property name="submenu">view</property>
      </packing>
    </child>
  </object>
</interface>
